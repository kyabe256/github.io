# Python
.venv/
__pycache__/
*.pyc

# フォント本体は再配布せず、book/build/fetch_fonts.py がビルド時に取得する
book/assets/fonts/*.ttf
book/assets/fonts/*.woff2
nihonseiji/assets/fonts/*.ttf
nihonseiji/assets/fonts/*.woff2

# ビルドの中間生成物
book/out/*.html
nihonseiji/out/*.html

# 数式レンダラの依存（npm で取得する）
tools/mathrender/node_modules/
tools/mathrender/package-lock.json

# 数式SVGのキャッシュ（TeXのSHA256をキーに再生成できる）
isoukaiseki/assets/fonts/*.ttf
isoukaiseki/assets/fonts/*.woff2
isoukaiseki/out/*.html
isoukaiseki/build/mathcache/
